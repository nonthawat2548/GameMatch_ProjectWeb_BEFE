{
  "name": "gamematch-fe",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.30.6",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "check": "npm run format:check && npm test -- --watchAll=false --runInBand && npm run build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.cjs\" \"public/**/*.html\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.cjs\" \"public/**/*.html\" \"*.{json,js}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
